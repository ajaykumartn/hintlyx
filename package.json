{
  "name": "hintlyx",
  "version": "0.1.2",
  "description": "Hintlyx: a fast AI copilot for meetings and interview practice",
  "author": "ajaykumar",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:invisibility": "electron-vite build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-invisibility.ps1",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "in.ajaytn.hintlyx",
    "productName": "Hintlyx",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": ["out/**/*", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Hintlyx-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "icon": "resources/icon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "identity": null,
      "artifactName": "Hintlyx-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Hintlyx transcribes meeting audio so it can help you respond.",
        "NSScreenCaptureUsageDescription": "Hintlyx reads your screen to answer questions about what you see."
      }
    }
  },
  "overrides": {
    "csstype": "3.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1"
  }
}
